# Public (shipped to the browser). Never put secrets here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hermit (bridgeIndexer) endpoints used by the live feed and transaction detail.
# Both are inlined at build time: redeploy after changing either one.
# Must be wss:// and https:// in production; ws:// and http:// only for local dev.
NEXT_PUBLIC_HERMIT_WS_URL=ws://localhost:8080/api/v1/transactions/stream
NEXT_PUBLIC_HERMIT_API_URL=http://localhost:8080

# Server-only. The indexer origin, reached through app/api/* route handlers.
API_BASE_URL=http://localhost:8080
# Milliseconds before a proxied indexer request is aborted.
API_TIMEOUT_MS=8000
