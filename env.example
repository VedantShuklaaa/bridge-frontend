# Public (shipped to the browser). Never put secrets here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Must be wss:// in production. ws:// only for local dev.
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/transactions/stream

# Server-only. The indexer origin, reached through app/api/* route handlers.
API_BASE_URL=http://localhost:8080
# Milliseconds before a proxied indexer request is aborted.
API_TIMEOUT_MS=8000
