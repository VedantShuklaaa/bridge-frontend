# Public (shipped to the browser). Never put secrets here.
# Canonical origin for metadata and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. The indexer origin, reached through app/api/* route handlers.
# The browser never talks to the indexer directly.
API_BASE_URL=http://localhost:8080
# Milliseconds before a proxied indexer request is aborted.
API_TIMEOUT_MS=8000
